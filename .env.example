# Copy to .env and fill in. Never commit .env.

# LLM (provider-agnostic; any provider supported by langchain's init_chat_model).
# Install the matching integration package too, e.g. `uv add langchain-anthropic`.
LLM_PROVIDER=
LLM_MODEL_FAST=
LLM_MODEL_STRONG=
# Optional: point the provider at another server (see README for LM Studio and Ollama Cloud).
LLM_BASE_URL=
# Optional: json_schema | function_calling | json_mode. Use function_calling for servers that
# ignore JSON schemas (e.g. Ollama Cloud). Unset uses the provider's default.
LLM_STRUCTURED_OUTPUT_METHOD=
# Provider API key(s), read by the provider package, e.g.:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Domain-restricted web search
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=

# Native source APIs
GUARDIAN_API_KEY=
NYT_API_KEY=

# Sent in the User-Agent so source APIs can identify the client
CONTACT_EMAIL=

CACHE_TTL_SECONDS=900
ADAPTER_TIMEOUT_SECONDS=8

# Hardening and observability
HTTP_MAX_RETRIES=2                 # retries on connection errors and 429/502/503/504
SEARCH_RATE_LIMIT_PER_MINUTE=30    # per client IP; 0 disables
LOG_LEVEL=INFO
LOG_FORMAT=text                    # text | json
